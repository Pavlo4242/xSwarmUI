<div class="preview-container">
    <div class="d-flex justify-content-between align-items-center p-2 mb-1" style="background: var(--input-background); border-bottom: 1px solid var(--border-color);">
        <div class="d-flex align-items-center gap-2">
            <h2 class="m-0 fs-5"><i class="fas fa-eye"></i> Live Preview</h2>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="form-check form-switch m-0" title="Automatically generate preview when parameters change">
                <input class="form-check-input" type="checkbox" id="preview_auto_generate" checked>
                <label class="form-check-label" for="preview_auto_generate">Auto-Gen</label>
            </div>
            <div class="btn-group btn-group-sm">
                <button id="preview_sync_main" class="btn btn-outline-secondary" title="Pull settings from Main Tab">
                    <i class="fas fa-download"></i> Pull
                </button>
                <button id="preview_copy_to_main" class="btn btn-outline-secondary" title="Push settings to Main Tab">
                    <i class="fas fa-upload"></i> Push
                </button>
            </div>
            <button id="preview_generate" class="btn btn-primary btn-sm px-3">
                <i class="fas fa-play"></i> Generate
            </button>
        </div>
    </div>

    <div class="preview-main">
        <div class="preview-left">
            <div class="preview-section">
                <h3 class="fs-6 mb-2">Prompts</h3>
                <textarea id="preview_prompt" class="form-control form-control-sm mb-2" rows="3" placeholder="Positive Prompt"></textarea>
                <textarea id="preview_negative_prompt" class="form-control form-control-sm" rows="3" placeholder="Negative Prompt"></textarea>
            </div>

            <div class="preview-section">
                <h3 class="fs-6 mb-2">Parameters</h3>
                <div class="d-flex flex-column gap-2">
                    <div>
                        <label class="form-label small mb-1">Model</label>
                        <select id="preview_model" class="form-select form-select-sm"></select>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small mb-1">Steps</label>
                            <input type="number" id="preview_steps" class="form-control form-control-sm" value="20" min="1">
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-1">CFG</label>
                            <input type="number" id="preview_cfgscale" class="form-control form-control-sm" value="7" step="0.5">
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-1">Width</label>
                            <input type="number" id="preview_width" class="form-control form-control-sm" value="512" step="64">
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-1">Height</label>
                            <input type="number" id="preview_height" class="form-control form-control-sm" value="512" step="64">
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-1">Seed</label>
                            <input type="number" id="preview_seed" class="form-control form-control-sm" value="-1" placeholder="-1 (Random)">
                        </div>
                    </div>
                </div>
            </div>

            <div class="preview-section flex-grow-1 d-flex flex-column" style="min-height: 200px;">
                <h3 class="fs-6 mb-2">Active LoRAs</h3>
                <div id="preview_loras_container" class="overflow-auto flex-grow-1"></div>
            </div>
        </div>

        <div class="preview-center">
            
            <div class="preview-image-container">
                <img id="preview_image" src="imgs/model_placeholder.jpg" alt="Preview">
                
                <div id="preview_step_info" class="position-absolute top-0 end-0 m-2 badge bg-dark opacity-75 fs-6 shadow" style="display:none; z-index: 10;">
                    Step: 0/20
                </div>

                <div id="preview_progress" class="position-absolute bottom-0 start-0 w-100" style="display:none; height: 6px; background: rgba(0,0,0,0.3);">
                    <div id="preview_progress_fill" class="h-100" style="width: 0%; background: var(--accent-color); box-shadow: 0 0 10px var(--accent-color);"></div>
                </div>
                
                <div id="preview_error" class="alert alert-danger position-absolute top-50 start-50 translate-middle shadow-lg" style="display:none;"></div>
            </div>

            <div id="preview_walker_container" class="step-walker-container" style="display:none;">
                <span class="small fw-bold text-nowrap"><i class="fas fa-history"></i> Replay:</span>
                <input type="range" id="preview_step_slider" class="form-range step-range" min="0" value="0">
                <span id="preview_walker_label" class="badge bg-secondary" style="min-width: 30px;">0</span>
            </div>

            <div class="session-history" id="preview_history">
                <div class="text-muted small m-auto">Session History</div>
            </div>
        </div>
    </div>
</div>