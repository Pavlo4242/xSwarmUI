<div class="preview-container-wrapper">
    <style>
        .preview-container-wrapper { height: calc(100vh - 80px) !important; width: 100% !important; display: flex !important; flex-direction: column !important; background: #1a1a1a !important; color: #eee !important; font-family: sans-serif; overflow: hidden !important; }
        .p-header { height: auto !important; min-height: 70px !important; background: #252525 !important; border-bottom: 1px solid #444 !important; padding: 10px 15px !important; display: flex !important; flex-direction: column !important; gap: 8px !important; }
        .p-header-row { display: flex !important; align-items: center !important; gap: 10px !important; flex-wrap: wrap !important; }
        .p-header-row.main { justify-content: space-between !important; }
        .p-header-row.params { justify-content: flex-start !important; }
        .preview-grid { display: flex !important; flex-direction: row !important; flex: 1 !important; overflow: hidden !important; }
        .p-col-left { width: 380px !important; min-width: 380px !important; background: #202020 !important; border-right: 1px solid #444 !important; padding: 15px !important; overflow-y: auto !important; display: flex !important; flex-direction: column !important; gap: 10px !important; }
        .p-col-center { flex: 1 !important; background: #000 !important; display: flex !important; flex-direction: column !important; position: relative !important; overflow: hidden !important; }
        .p-col-right { width: 380px !important; min-width: 380px !important; background: #202020 !important; border-left: 1px solid #444 !important; padding: 15px !important; overflow-y: auto !important; }
        .p-prompt-area { height: 200px !important; min-height: 200px !important; background: #1a1a1a !important; border-top: 1px solid #444 !important; display: flex !important; gap: 10px !important; padding: 10px !important; }
        .p-prompt-box { flex: 1 !important; display: flex !important; flex-direction: column !important; gap: 5px !important; }
        .p-input { background: #333 !important; border: 1px solid #555 !important; color: #eee !important; width: 100% !important; padding: 6px !important; border-radius: 4px !important; box-sizing: border-box !important; font-size: 13px !important; }
        .p-input:focus { border-color: #0d6efd !important; outline: none !important; }
        .p-input.inline { flex: 0 0 auto !important; width: 100px !important; }
        .p-btn { background: #444 !important; border: 1px solid #555 !important; color: #eee !important; padding: 5px 15px !important; border-radius: 4px !important; cursor: pointer !important; white-space: nowrap !important; }
        .p-btn:hover { background: #555 !important; }
        .p-btn-primary { background: #0d6efd !important; border-color: #0d6efd !important; font-weight: bold !important; }
        .p-label { font-size: 11px !important; font-weight: bold !important; color: #ccc !important; margin-bottom: 3px !important; display: block !important; }
        .p-overlay-info { position: absolute; top: 20px; left: 20px; background: rgba(0,0,0,0.7); padding: 10px; border-radius: 4px; font-size: 14px; }
        .generating { filter: brightness(0.8); }
        .p-lora-item { background: #2a2a2a; padding: 8px; border-radius: 4px; margin-bottom: 8px; border: 1px solid #444; }
        .p-lora-controls { display: flex; align-items: center; gap: 8px; margin-top: 5px; }
        .p-lora-weight { flex: 1; text-align: center; font-size: 14px; font-weight: bold; color: #0d6efd; }
        .p-btn-small { padding: 2px 8px !important; font-size: 12px !important; }
    </style>

    <div class="p-header">
        <div class="p-header-row main">
            <div style="display: flex; gap: 10px; align-items: center;">
                <button id="p_pull" class="p-btn p-btn-primary" title="Sync from Main Generate Tab">← Sync Main</button>
                <button id="p_push" class="p-btn" title="Push to Main Tab">Push to Main</button>
                <span id="p_connection_status" style="color:#888; font-size:12px;">Disconnected</span>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <label class="p-toggle" style="display:flex; align-items:center; gap:5px;">
                    <input type="checkbox" id="p_auto" checked>
                    <span style="font-size:12px;">Auto</span>
                </label>
                <label class="p-toggle" style="display:flex; align-items:center; gap:5px;">
                    <input type="checkbox" id="p_watch_main" checked>
                    <span style="font-size:12px;">Watch Main</span>
                </label>
                <button id="p_gen" class="p-btn p-btn-primary">Generate</button>
                <button id="p_interrupt" class="p-btn" style="display:none;">Interrupt</button>
                <button id="p_diagnostics" class="p-btn">🔧 Debug</button>
                <label style="display:flex; align-items:center; gap:5px;">
                    <input type="checkbox" id="p_modify_mode">
                    <span style="font-size:12px; color:#eee;">Modify</span>
                </label>
                <span id="p_modify_warning" style="color:#ff6b6b; font-weight:bold; display:none;">MODIFY</span>
            </div>
        </div>
        
        <div class="p-header-row params">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="p-label" style="margin: 0;">Model</span>
                <select id="p_model" class="p-input inline" style="width: 200px !important;"></select>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="p-label" style="margin: 0;">Width</span>
                <input type="number" id="p_width" class="p-input inline" value="512" step="64" min="256" max="2048">
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="p-label" style="margin: 0;">Height</span>
                <input type="number" id="p_height" class="p-input inline" value="512" step="64" min="256" max="2048">
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="p-label" style="margin: 0;">Seed</span>
                <input type="number" id="p_seed" class="p-input inline" value="-1" style="width: 120px !important;">
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="p-label" style="margin: 0;">Steps</span>
                <input type="number" id="p_steps" class="p-input inline" value="20" min="1" max="100" style="width: 80px !important;">
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="p-label" style="margin: 0;">CFG</span>
                <input type="number" id="p_cfg" class="p-input inline" value="7" step="0.5" min="1" max="30" style="width: 80px !important;">
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="p-label" style="margin: 0;">Batch</span>
                <input type="number" id="p_batch" class="p-input inline" value="1" min="1" max="8" style="width: 70px !important;">
            </div>
        </div>
    </div>

    <div class="preview-grid">
        <div class="p-col-left">
            <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
                <span class="p-label" style="margin: 0;">LoRA Browser</span>
                <button id="p_refresh_loras_browser" style="background:none; border:none; color:#888; cursor:pointer; font-size: 16px;" title="Refresh">↻</button>
            </div>
            <input type="text" id="p_lora_search" class="p-input" placeholder="Search LoRAs..." style="margin-bottom: 10px;">
            <div id="p_lora_browser" style="display:flex; flex-direction:column; gap:8px; flex: 1; overflow-y: auto;">
                <div style="color:#666; font-size:11px; text-align:center;">Loading LoRAs...</div>
            </div>
        </div>

        <div class="p-col-center">
            <div class="p-image-area" style="position: relative; flex: 1; display: flex; align-items: center; justify-content: center;">
                <img id="p_img" src="imgs/model_placeholder.jpg" style="max-width: 95%; max-height: 95%; object-fit: contain;">
                <div id="p_info" class="p-overlay-info" style="display:none;">Ready</div>
                <div id="p_progress" style="position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); width: 80%; height: 4px; background: rgba(0,0,0,0.7); border-radius: 2px; display:none;">
                    <div id="p_fill" style="height: 100%; background: #0d6efd; width: 0%; transition: width 0.3s; border-radius: 2px;"></div>
                </div>
                <div id="p_error" style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:red; color:white; padding:15px; display:none; border-radius:4px; max-width:80%; text-align:center; z-index: 10;"></div>
            </div>
            
            <div id="p_history" class="p-history" style="height: 120px; min-height: 120px; overflow-y: auto; background: #0a0a0a; padding: 10px; font-size: 12px; border-top: 1px solid #444;">
                <div style="margin:auto; color:#666; font-style:italic;">History (latest at top)</div>
            </div>
        </div>

        <div class="p-col-right">
            <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
                <span class="p-label" style="margin: 0;">Active LoRAs <span id="p_lora_count">(0)</span></span>
                <button id="p_clear_loras" class="p-btn p-btn-small" style="display:none;">Clear All</button>
            </div>
            <div id="p_loras" style="display:flex; flex-direction:column; gap:8px;">
                <div style="color:#666; font-size:11px; text-align:center;">No LoRAs selected</div>
            </div>
            
            <hr style="border:0; border-top:1px solid #444; margin: 20px 0;">
            
            <div style="display:flex; gap:10px; flex-direction: column;">
                <label class="p-toggle" style="display:flex; align-items:center; gap:5px;">
                    <input type="checkbox" id="p_save_interims">
                    <span style="font-size:12px; color:#ccc;">Save Interim Images</span>
                </label>
                <button id="p_clear_history" class="p-btn" style="width: 100%;">Clear History</button>
            </div>
        </div>
    </div>
    
    <div class="p-prompt-area">
        <div class="p-prompt-box">
            <span class="p-label">Positive Prompt</span>
            <textarea id="p_prompt" class="p-input" rows="6" placeholder="Enter prompt..." style="resize: vertical; flex: 1;">a cat</textarea>
        </div>
        <div class="p-prompt-box">
            <span class="p-label">Negative Prompt</span>
            <textarea id="p_neg" class="p-input" rows="6" placeholder="Negative Prompt" style="resize: vertical; flex: 1;"></textarea>
        </div>
    </div>

    <div id="p_debug" style="height: 60px !important; background: #0a0a0a !important; color: #0f0 !important; font-family: 'Courier New', monospace !important; font-size: 10px !important; padding: 5px !important; overflow-y: auto !important; border-top: 1px solid #444 !important; display: none;"></div>
</div>